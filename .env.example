# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Nebius Token Factory (OpenAI-compatible). All LLM calls go here, directly.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron models via Nebius (ids may change — set them here, not in code).
# Attacker = the hard, creative job (TAP). Target = the agent under test.
MODEL_ATTACKER=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_TARGET=nvidia/Nemotron-3_5-Lightning

# Safety rails
MAX_ATTEMPTS=10
BUDGET_USD=3.00
# Per-request upstream timeout. Keep this finite so abandoned live runs fail closed.
NEBIUS_TIMEOUT_S=60

# Reserved for a later slice (model decides when to search). Unused today.
TAVILY_API_KEY=

# Optional: degrade to this model if the requested one is unavailable (hosted demo
# only; leave empty for benchmarks so numbers are always on the named model).
MODEL_FALLBACK=

# ---- Hosted web demo (app.py) ----
# Kill switch: 0 = no live runs (replays only).
DEMO_LIVE_ENABLED=1
# Judge code; without Redis, live runs require it.
DEMO_ACCESS_CODE=
# Optional: override the web demo's target model ids (default: current Nemotron ids).
# Separate from MODEL_TARGET above, which only sets the CLI benchmark target.
MODEL_TARGET_LIGHTNING=
MODEL_TARGET_NANO=
MODEL_TARGET_ULTRA=
# Hard cap per live campaign (USD) and attempts per campaign.
DEMO_RUN_BUDGET_USD=0.10
DEMO_MAX_ATTEMPTS=6
# Public (no-code) pool per UTC day; all live runs per UTC day; lifetime cap.
DEMO_DAILY_PUBLIC_USD=0.50
DEMO_DAILY_BUDGET_USD=1.50
DEMO_TOTAL_BUDGET_USD=15.00
# Public live runs per IP per hour.
DEMO_IP_RUNS_PER_HOUR=3
# Shared counters (set automatically by the Vercel Upstash integration).
# Without them, public live runs stay off (fail-closed).
KV_REST_API_URL=
KV_REST_API_TOKEN=
